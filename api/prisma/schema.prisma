// DaaS — Sprint 2 slice: purchase order receiving.
//
// Conventions applied to every table:
//   - uuid primary key, generated as UUIDv7 so ids sort by creation time
//   - created_at / updated_at on every mutable table
//   - soft delete via deleted_at
//
// Two tables deliberately break the soft-delete convention, and the README
// architecture note explains why:
//   - stock_movements is an append-only ledger. A movement is a historical
//     fact; you reverse it with a compensating movement, you never delete it.
//   - stock_on_hand is a derived projection of that ledger, keyed by
//     (product, location). It is a cache, so there is nothing to soft delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  ALLOCATION

  @@map("movement_type")
}

/// A customer of the platform. Every row of business data belongs to exactly
/// one, and the Prisma extension in `shared/tenancy.ts` scopes every query to
/// the tenant on the current request.
model Tenant {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Stable, url-safe. Used in logs and support conversations, never as a key.
  slug String @db.VarChar(64)
  name String @db.VarChar(160)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  features       TenantFeature[]
  users          User[]
  roles          Role[]
  vendors        Vendor[]
  products       Product[]
  locations      Location[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  stockOnHand    StockOnHand[]

  @@map("tenants")
}

/// Which features a tenant has switched on.
///
/// Absence means off, so a new feature is dark for everyone until someone turns
/// it on -- the safe default when the flag guards something not every customer
/// has paid for or is ready to see.
model TenantFeature {
  tenantId String @map("tenant_id") @db.Uuid
  /// Matches a key in `shared/features.ts`, which is the source of truth for
  /// what a feature means. Unknown keys are ignored rather than trusted.
  featureKey String  @map("feature_key") @db.VarChar(64)
  enabled    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureKey])
  @@map("tenant_features")
}

model User {
  id    String @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  email String @db.VarChar(320)
  name  String @db.VarChar(120)
  /// scrypt, encoded as `scrypt$N$r$p$salt$hash`. The parameters travel with
  /// the hash so they can be raised later without invalidating old passwords.
  passwordHash String @map("password_hash") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  refreshTokens  RefreshToken[]
  roles          UserRole[]
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

/// A single access right, e.g. `stock:receive`.
///
/// Seeded from the catalogue in `src/shared/permissions.ts`, which is the
/// source of truth: the application can only check permissions it knows about
/// at compile time. These rows exist so role grants can reference them with a
/// foreign key rather than a loose string.
model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(64)
  description String @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

/// A named bundle of permissions.
///
/// Roles carry no capability of their own -- nothing in the codebase branches
/// on a role key. They exist so permissions can be granted in meaningful groups
/// and changed without a deploy.
model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// Roles are per-tenant: each tenant gets its own copy of the system roles
  /// and may add more, without touching anyone else's access.
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String  @db.VarChar(32)
  name        String  @db.VarChar(80)
  description String? @db.VarChar(300)
  /// Shipped with the product and undeletable: an install with no admin role
  /// cannot be recovered through the UI.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("roles")
}

/// Which permissions a role grants. Editable at runtime.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Which roles a user holds. A user may hold several; their effective
/// permissions are the union, so roles add access and never remove it.
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  /// Null for roles granted by the seed or a migration rather than a person.
  assignedById String?  @map("assigned_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per issued refresh token.
///
/// Refresh tokens are opaque random bytes rather than JWTs: they must be
/// revocable, which makes them stateful anyway, so a signed self-describing
/// token would buy nothing. Only the SHA-256 hash is stored, for the same
/// reason passwords are hashed -- a dump of this table must not yield usable
/// sessions.
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token, hex. Unique so a lookup is a single index hit.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  /// Every token rotated from one login shares a family id. Presenting an
  /// already-rotated token means it leaked, and the whole family is revoked.
  familyId String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when this token was exchanged for a new one. Non-null means spent.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Set on logout, or when reuse detection kills the family.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Captured for the audit trail, so a suspicious session is identifiable.
  userAgent String? @map("user_agent") @db.VarChar(400)
  ipAddress String? @map("ip_address") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Vendor {
  id   String  @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  code String  @db.VarChar(32)
  name String  @db.VarChar(160)
  email String? @db.VarChar(320)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("vendors")
}

model Product {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  sku  String @db.VarChar(64)
  name String @db.VarChar(200)
  // Unit of measure. Receiving is whole units only, so quantities are integers.
  unit String @default("ea") @db.VarChar(16)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  purchaseOrderLines PurchaseOrderLine[]
  stockMovements     StockMovement[]
  stockOnHand        StockOnHand[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("products")
}

model Location {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  code String @db.VarChar(32)
  name String @db.VarChar(160)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  stockOnHand    StockOnHand[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("locations")
}

/// A purchase order header.
///
/// There is no `status` column on purpose. Status is OPEN / PARTIAL / RECEIVED
/// derived from how much of each line has been received, and it is computed by
/// the `purchase_order_status` SQL view. A stored flag would let the header and
/// the ledger disagree; a view cannot.
model PurchaseOrder {
  id         String  @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  poNumber   String  @map("po_number") @db.VarChar(32)
  vendorId   String  @map("vendor_id") @db.Uuid
  /// Default receiving location for the order. A receipt may override it
  /// per call, which is what makes multi-location receiving possible later.
  locationId String  @map("location_id") @db.Uuid
  notes      String? @db.VarChar(2000)
  createdById String @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  location  Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]

  // The single-column vendor/location indexes were replaced by partial
  // composites on (vendor_id, id DESC) WHERE deleted_at IS NULL, which serve
  // both the filter and the keyset in one seek. Prisma cannot express partial
  // or DESC-ordered indexes, so they live in the migration SQL.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("purchase_orders")
}

/// One product on a purchase order.
///
/// `quantityReceived` is NOT a column. It is SUM(stock_movements.quantity) for
/// RECEIPT movements pointing at this line, exposed by the
/// `purchase_order_line_totals` view.
model PurchaseOrderLine {
  id              String @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  quantityOrdered Int    @map("quantity_ordered")
  /// Money as integer cents. Never floats.
  unitCostCents   Int    @map("unit_cost_cents")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements     StockMovement[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

/// Append-only stock ledger. Every change to on-hand quantity, from any sprint
/// (receive, adjust, transfer, allocate), lands here first as a signed row.
/// No updated_at, no deleted_at: rows are immutable.
model StockMovement {
  id         String       @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  locationId String       @map("location_id") @db.Uuid
  /// Signed. Positive adds to on-hand, negative removes.
  quantity   Int
  type       MovementType
  /// Set when the movement came from receiving a PO line. Nullable because
  /// adjustments and transfers have no PO behind them.
  purchaseOrderLineId String? @map("purchase_order_line_id") @db.Uuid
  reason     String?      @db.VarChar(500)
  createdById String      @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, locationId])
  @@index([purchaseOrderLineId])
  @@index([createdAt])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stock_movements")
}

/// Running on-hand quantity per (product, location), maintained in the same
/// transaction as the movement that changed it. A projection of the ledger:
/// SUM(stock_movements.quantity) GROUP BY product, location must always equal
/// this table, and `npm run check:ledger` asserts exactly that.
model StockOnHand {
  id         String @id @default(uuid(7)) @db.Uuid
  /// Owning tenant. Injected automatically; never set by a resolver.
  tenantId String @map("tenant_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  quantity   Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId], map: "stock_on_hand_product_location_key")
  // (location_id, quantity) lives in the migration SQL: it serves the location
  // filter and the `inStockOnly` predicate together.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stock_on_hand")
}
