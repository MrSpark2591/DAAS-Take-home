# Postgres started by docker-compose.yml at the repo root.
DATABASE_URL="postgresql://daas:daas@localhost:5432/daas?schema=public"

# Apollo Server
PORT=4000

# Signs access tokens (HS256). Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-secret-change-me-at-least-32-chars-long"

# Access tokens are short because they are stateless and cannot be revoked.
# Refresh tokens are long-lived but stored, rotated on use, and revocable.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Password given to every seeded user by `npm run seed`.
SEED_PASSWORD="daas-dev-password"

# Dev-only convenience. When true, the API prints the seeded sign-ins on boot
# and enables the Apollo landing page. Never enable in production.
DEV_AUTH_DEBUG=true
